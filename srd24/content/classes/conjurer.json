  {
    "id": "srd24:conjurer:benign-transposition",
    "kind": "subclass-feature",
    "name": "Benign Transposition",
    "source": "srd24",
    "page": "AU 15",
    "tags": [
      "conjurer-feature",
      "wizard-feature"
    ],
    "text": "As a Bonus Action, you teleport up to 30 feet to an unoccupied space that you can see. Alternatively, you can choose a space within range that is occupied by a Medium or smaller creature. If that creature is willing, you both teleport, swapping places.\n\nYou can use this feature a number of times equal to your Intelligence modifier (minimum of once), and you regain all expended uses when you finish a Long Rest.",
    "resources": [
      {
        "id": "srd24:conjurer:benign-transposition",
        "name": "Benign Transposition",
        "max": "max(1, @abilities.int.mod)",
        "recharge": [
